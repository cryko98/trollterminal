# Required: OpenAI API key (used by /api/state).
OPENAI_API_KEY=sk-proj-replace-with-your-key

# Required for shared state in production (Upstash Redis).
# In local dev you can leave these empty — the API falls back to in-memory
# state (fine for one machine; useless on serverless).
# Vercel: add the Upstash Redis integration in the Marketplace and these
# get auto-injected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
